NODE_ENV=production
PORT=10000
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
KASA_DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
KASA_DB_PORT=4000
KASA_DB_NAME=kasa_ilaya_resort
KASA_DB_USER=YOUR_TIDB_USER
KASA_DB_PASS=YOUR_TIDB_PASSWORD
# Optional email/OTP
KASA_MAIL_ENABLED=false
KASA_SMTP_HOST=smtp.gmail.com
KASA_SMTP_PORT=587
KASA_SMTP_USER=
KASA_SMTP_PASS=
KASA_MAIL_FROM_EMAIL=
KASA_MAIL_FROM_NAME=Kasa Ilaya Resort & Event Place
KASA_ADMIN_NOTIFICATION_EMAIL=
KASA_GOOGLE_CLIENT_ID=
