NODE_ENV=production
PORT=10000
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
KASA_DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
KASA_DB_PORT=4000
KASA_DB_NAME=kasa_ilaya_resort
KASA_DB_USER=YOUR_TIDB_USER
KASA_DB_PASS=YOUR_TIDB_PASSWORD
# Brevo SMTP email/OTP
KASA_MAIL_ENABLED=true
KASA_SMTP_HOST=smtp-relay.brevo.com
KASA_SMTP_PORT=587
KASA_SMTP_USER=your-brevo-smtp-login
KASA_SMTP_PASS=your-brevo-smtp-key
KASA_MAIL_FROM_EMAIL=your-verified-sender@example.com
KASA_MAIL_FROM_NAME=Kasa Ilaya Resort
KASA_ADMIN_NOTIFICATION_EMAIL=
# Google OAuth Web Client ID. KASA_GOOGLE_CLIENT_ID is preferred; GOOGLE_CLIENT_ID also works.
KASA_GOOGLE_CLIENT_ID=834800627360-tj8514jf4tqk46oodm358bu9thvub21f.apps.googleusercontent.com
